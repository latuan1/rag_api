# Server and authentication
RAG_HOST=0.0.0.0
RAG_PORT=8000
JWT_SECRET=

# pgvector database
VECTOR_DB_TYPE=pgvector
POSTGRES_USE_UNIX_SOCKET=False
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
DB_HOST=db
DB_PORT=5432
PGVECTOR_CREATE_EXTENSION=True
PG_POOL_PRE_PING=True
PG_POOL_RECYCLE=-1
POSTGRES_SCHEMA=

# Vector store, chunking, uploads, and batching
COLLECTION_NAME=testcollection
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
RAG_UPLOAD_DIR=./uploads/
EMBEDDING_BATCH_SIZE=500
EMBEDDING_MAX_QUEUE_SIZE=3
RAG_DISTANCE_THRESHOLD=

# PDF/OCR and logging
PDF_EXTRACT_IMAGES=False
PDF_OCR_ENABLED=True
PDF_OCR_LANGS=eng+vie
PDF_OCR_MIN_TEXT_CHARS=20
PDF_OCR_DPI=200
DEBUG_RAG_API=False
DEBUG_PGVECTOR_QUERIES=False
CONSOLE_JSON=False
RAG_THREAD_POOL_SIZE=

# Embeddings provider selection
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_CHUNK_SIZE=200
EMBEDDINGS_DIMENSIONS=
RAG_CHECK_EMBEDDING_CTX_LENGTH=True

# OpenAI-compatible embeddings
OPENAI_API_KEY=
RAG_OPENAI_API_KEY=
RAG_OPENAI_BASEURL=
RAG_OPENAI_PROXY=

# Azure OpenAI embeddings
AZURE_OPENAI_API_KEY=
RAG_AZURE_OPENAI_API_KEY=
RAG_AZURE_OPENAI_ENDPOINT=
RAG_AZURE_OPENAI_API_VERSION=

# Hugging Face and Ollama embeddings
HF_TOKEN=
OLLAMA_BASE_URL=http://ollama:11434

# Bedrock embeddings
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Google GenAI / Vertex AI embeddings
GOOGLE_API_KEY=
GOOGLE_KEY=
RAG_GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Atlas MongoDB vector store
ATLAS_MONGO_DB_URI=mongodb://127.0.0.1:27018/LibreChat
ATLAS_SEARCH_INDEX=vector_index
MONGO_VECTOR_COLLECTION=

# Local knowledge retrieval endpoints
KNOWLEDGE_API_TOKEN=
RETRIEVAL_DATABASE_URL=
RETRIEVAL_DATASET_NAMESPACE=vinuni-policy
RETRIEVAL_EMBEDDING_API_KEY=
RETRIEVAL_EMBEDDING_BASE_URL=
RETRIEVAL_EMBEDDING_PROVIDER=google-gemini
RETRIEVAL_EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_EMBEDDING_DIMENSIONS=1536
RETRIEVAL_EMBEDDING_INPUT_VERSION=v1
RETRIEVAL_EMBEDDING_PROFILE=
RETRIEVAL_DEFAULT_MATCH_COUNT=10
RETRIEVAL_DEFAULT_MATCH_THRESHOLD=0.0
RETRIEVAL_DATABASE_COMMAND_TIMEOUT=30
RETRIEVAL_DATABASE_STATEMENT_CACHE_SIZE=100
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=30
